# Eight concurrent agents at up to 212,992 tokens each on one GB10.
# Usage (from the repository root, after scripts/bootstrap.sh):
#   set -a; . profiles/gb10-8x200k.env; set +a
#   .venv/bin/python scripts/supervise.py --receipt results/serve-$(date +%s).jsonl
# Measured results and caveats: docs/optimizations.md ("Full-graph stack",
# "Capacity for 8 x 200k").

# No activation quantization: routed experts keep their NVFP4 weights but run
# with BF16 activations (Marlin W4A16; the default NVFP4 backend also rounds
# activations to FP4, 7-10% error per MoE output). GDN/QSA projections use
# FP8 weights with BF16 activations (W8A16); shared experts, lm_head and
# embeddings are unchanged; GDN state is BF16. See docs/optimizations.md.
FLASHNEXT_MOE_BACKEND=marlin
FLASHNEXT_DENSE_W8A16=1
FLASHNEXT_W8A16_SHARED=0
FLASHNEXT_TEXT_ONLY=1
FLASHNEXT_KV_DTYPE=fp8
FLASHNEXT_SSM_DTYPE=bfloat16
FLASHNEXT_SEQUENCES=8
FLASHNEXT_CONTEXT=212992

# MTP-3 speculation with a draft-only vocabulary built from public vLLM source.
FLASHNEXT_MTP=3
FLASHNEXT_MTP_INDEX_SHARE=1
FLASHNEXT_DRAFT_VOCAB=profiles/draft-vocab-vllm-a33b3ba.json

# Whole-step CUDA graphs; PLE rows are read from the checkpoint and staged before each step.
FLASHNEXT_CUDAGRAPH_MODE=FULL_AND_PIECEWISE
FLASHNEXT_PLE_DIRECT=1
FLASHNEXT_PLE_IO=buffered
FLASHNEXT_PLE_PREFORWARD=1
FLASHNEXT_PACK_PLE_STATE=1
# PLE row cache and early reads of the next step's rows during drafting
# (lossless; 8 x 200k: 115.6 -> 132.7 tok/s on the rented host, docs/optimizations.md).
FLASHNEXT_PLE_ROW_CACHE_GIB=3
FLASHNEXT_PLE_IO_THREADS=64
FLASHNEXT_PLE_EARLY=1
# Read prompt PLE rows up to 8k tokens ahead of chunked prefill (lossless; +43% on a cold 200k fill here).
FLASHNEXT_PLE_PREFILL_AHEAD=8192

# 8 x 202k tokens need about 24.2 GiB of cache at about 16 KB per token.
FLASHNEXT_KV_BYTES=26306674688
FLASHNEXT_MEMORY_FRACTION=0.60
# Smaller prefill chunks bound the long-context prefill temporaries.
# 4096-token prefill chunks: each chunk streams all 68 GB of experts once, so larger chunks amortize it;
# 8192 fell below the 6 GiB host floor during a 200k fill (6.29 GB), 4096 kept >= 7.1 GB.
FLASHNEXT_PREFILL=4096
# Prefill-size W8A16: dequantize FP8 blocks + cuBLAS where faster (fidelity unchanged vs the Triton path).
FLASHNEXT_W8A16_PREFILL=profiles/w8a16-prefill-gb10.json
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
FLASHNEXT_MIN_AVAILABLE_GIB=6
